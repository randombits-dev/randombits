---
interface Props {
  backHref?: string;
  backLabel?: string;
}

const {
  backHref = '/canva',
  backLabel = 'Back to all Canva apps',
} = Astro.props;
---
<div class="fs-page">
  <div class="container-sm fs-page__top">
    <a href={backHref} class="fs-page__back">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
      {backLabel}
    </a>
  </div>
  <slot/>
</div>

<style is:global>
  @import '../../styles/canva-app.scss';
</style>
