---
import Logo from "../Logo.astro";

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <nav aria-label="Main" class="site-header__nav">
    <a class="site-header__brand" href="/" aria-label="Home Page">
      <Logo width="48" includeDigits={false}/>
      <div class="site-header__brand-text">
        <div class="site-header__title">Random Bits</div>
        <div class="site-header__tagline">Software Engineering</div>
      </div>
    </a>
    <div class="site-header__links">
      <a href="/canva" class:list={["header-link", {active: currentPath.startsWith('/canva')}]}>Apps</a>
      <a href="/services" class:list={["header-link", {active: currentPath.startsWith('/services')}]}>Services</a>
      <a href="/articles" class:list={["header-link", {active: currentPath.startsWith('/articles') || currentPath.startsWith('/standard-notes')}]}>Articles</a>
      <a href="/about" class:list={["header-link", {active: currentPath.startsWith('/about')}]}>About</a>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-color);
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    max-width: 1040px;
    margin: 0 auto;
    padding: 0.85rem 1.25rem;
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-shrink: 0;
  }

  .site-header__brand-text {
    line-height: 1.2;
  }

  .site-header__title {
    font-family: var(--font-1);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-content);
  }

  .site-header__tagline {
    font-size: 0.8rem;
    color: var(--color-muted);
    margin-top: 0.1rem;
  }

  .site-header__links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .header-link.active {
    color: var(--color-content);
    background: var(--accent-soft);
  }

  @media (max-width: 640px) {
    .site-header__nav {
      flex-direction: column;
      align-items: stretch;
      padding: 1rem 1.25rem;
    }

    .site-header__links {
      justify-content: center;
    }
  }
</style>
