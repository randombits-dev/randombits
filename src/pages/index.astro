---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleList from "../components/article/ArticleList.astro";
import ProjectList from "../components/ProjectList.astro";
import {CANVA_APPS, PROJECTS} from "../data/projects.ts";
---

<BaseLayout title="Random Bits Software Engineering" description="Software engineering guides, articles, and projects.">
  <section class="home-hero">
    <div class="home-hero__glow" aria-hidden="true"></div>
    <div class="container home-hero__content">
      <p class="home-hero__eyebrow">Random Bits</p>
      <h1 class="home-hero__title">
        Software engineering,<br/>
        <span class="home-hero__accent">redefined.</span>
      </h1>
      <p class="home-hero__subtitle">
        Guides, open source projects, and Canva apps — built with care for performance and clarity.
      </p>
    </div>
  </section>

  <section class="section-block">
    <div class="container">
      <h2 class="section-heading">Canva apps</h2>
      <ProjectList items={CANVA_APPS} limit={2}/>
      <div class="flex justify-center pt-12">
        <a href="/canva" class="btn-primary">View all Canva apps</a>
      </div>
    </div>
  </section>

  <section class="section-block section-block--alt">
    <div class="container">
      <h2 class="section-heading">Open source projects</h2>
      <ProjectList items={PROJECTS} limit={2}/>
      <div class="flex justify-center pt-12">
        <a href="/projects" class="btn-primary">View all projects</a>
      </div>
    </div>
  </section>

  <section class="section-block">
    <div class="container">
      <h2 class="section-heading">Featured articles</h2>
      <ArticleList limit={6}/>
      <div class="flex justify-center pt-12">
        <a href="/articles" class="btn-primary">View all articles</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    overflow: hidden;
    padding: 6rem 0 5rem;
    text-align: center;
  }

  .home-hero__glow {
    position: absolute;
    inset: -40% -20% auto;
    height: 500px;
    background: radial-gradient(ellipse at center, var(--accent-soft) 0%, transparent 70%);
    pointer-events: none;
  }

  .home-hero__content {
    position: relative;
  }

  .home-hero__eyebrow {
    margin: 0 0 1rem;
    font-family: var(--font-1);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .home-hero__title {
    margin: 0;
    font-size: clamp(2.75rem, 7vw, 4.5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .home-hero__accent {
    color: var(--accent);
  }

  .home-hero__subtitle {
    margin: 1.5rem auto 0;
    max-width: 32rem;
    font-size: 1.15rem;
    color: var(--color-light);
    line-height: 1.6;
  }

  .section-block--alt {
    background: var(--back-2);
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
  }
</style>
