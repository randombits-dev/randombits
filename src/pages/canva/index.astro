---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectList from "../../components/ProjectList.astro";
import {CANVA_APPS} from "../../data/projects.ts";
---
<BaseLayout title="Projects by Random Bits" description="A list of all open source projects created by Random Bits">
  <div class="page-hero">
    <h1 class="page-hero__title">Canva apps</h1>
    <p class="page-hero__subtitle">Creative tools for the Canva marketplace, built by Random Bits.</p>
  </div>
  <div class="container pb-24">
    <ProjectList items={CANVA_APPS}/>
  </div>
</BaseLayout>
