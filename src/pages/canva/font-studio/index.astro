---
import BaseLayout from "@/layouts/BaseLayout.astro";
import {Image} from 'astro:assets';
import FontStudioLogo from '@/assets/canva/font-studio/logo.png';
import PresetCarousel from '@/components/canva/PresetCarousel.astro';
import CanvaAppShell from '@/components/canva/CanvaAppShell.astro';
import CanvaFeatureIcon from '@/components/canva/CanvaFeatureIcon.astro';
import CanvaAppSupport from '@/components/canva/CanvaAppSupport.astro';

const CANVA_URL = 'https://www.canva.com/apps/AAGLHfr5ZM0/fontstudio';

const features = [
  {title: 'Layered text effects', desc: 'Stack outlines, shadows, and 3D projections to build effects that go far beyond basic Canva text.', icon: 'layers' as const},
  {title: '100+ templates', desc: 'Start from polished presets and customize every layer — or build your own from scratch.', icon: 'template' as const},
  {title: 'Fine-grained control', desc: 'Adjust offset, blur, color, and blend per layer. Tweak until the type feels exactly right.', icon: 'sliders' as const},
  {title: 'Export to your design', desc: 'Send finished text straight into your Canva canvas — no screenshots, no workarounds.', icon: 'export' as const},
];

const premiumFeatures = [
  '15,000+ additional fonts',
  '100+ premium templates',
  'Upload custom fonts',
  'Special effects & extras',
];

const faqs = [
  {q: 'Are your fonts royalty-free?', a: 'Yes. All fonts can be used for commercial purposes with no restrictions.'},
  {q: 'Why is the output blurry?', a: 'The app auto-sizes text to fit the page width, which sometimes reduces resolution. Create a larger custom page (e.g. 3000×3000), export there, then copy the result into your real design.'},
  {q: 'Why is "Use selected image" disabled?', a: 'Only raster images (photos) work — not vector graphics. Workaround: place the image on a blank page, download as PNG or JPG, then select that file in the app.'},
  {q: 'Why can\'t I access Canva fonts?', a: 'Canva does not allow third-party apps to access their font library. FontStudio includes its own font collection instead.'},
  {q: 'I have Canva Pro — do I get Premium free?', a: 'No. FontStudio Premium is separate. As an independent developer, I charge a small fee to support ongoing development.'},
  {q: 'I purchased Premium but it\'s not showing.', a: 'Click "Reload app" in the Premium section. If it still fails, make sure you\'re on the same Canva account used at purchase.'},
];

const presets = [
  "color", "happy", "block", "outline", "swirl", "classic", "skinny", "bright", "cool",
  "pink", "disco", "neon", "good-times", "gameover", "blush", "stencil", "freight", "empty",
  "color-time", "crono", "great", "fine", "dancing-bears", "spray-paint", "sunrise", "party",
  "good-vibes", "rainbow", "rainy-day", "freeway", "clear", "icicle", "cosmos", "clash",
  "angle", "canvas", "turf", "rocks", "scary", "oodles", "scape", "alive", "modern", "green",
  "abolish", "sunny", "citrus", "wed", "roses", "lime", "two-ten", "open", "hoppin", "snap",
  "ball", "elastic", "home-club", "box-office", "dear-love", "torn-apart", "stop", "orin",
  "splash", "volts", "hard-work", "sheet", "cool-days", "freedom", "not-much", "not-yet",
  "shy", "rusty", "crazy", "galaxy", "polygon", "squiggle", "extra-bold", "gothic",
  "handwritten", "hardwired", "shade", "iron-age", "relaxed", "chalk", "super-nova", "monster",
  "soft-touch", "trance", "thrice", "kingdom", "labeled", "park", "split-decision", "supermix",
  "rapture", "metal-gear", "flexible", "ore", "blood-moon", "explore", "respite", "metallic",
  "sunblock", "dusk", "ice-box",
];
---
<BaseLayout
  title="FontStudio — Advanced Text Effects for Canva"
  description="FontStudio is a Canva app for creating advanced text effects with layered outlines, shadows, and 3D projections."
>
  <CanvaAppShell>
    <section class="fs-hero">
      <div class="fs-hero__bg" aria-hidden="true"></div>
      <div class="container-sm fs-hero__inner">
        <div class="fs-hero__brand">
          <Image width="80" height="80" src={FontStudioLogo} alt="" class="fs-hero__logo"/>
          <div>
            <p class="fs-hero__eyebrow">Canva app</p>
            <h1 class="fs-hero__title">FontStudio</h1>
            <p class="fs-hero__tagline">Advanced text effects for designs that need to stand out.</p>
          </div>
        </div>
        <div class="fs-hero__actions">
          <a class="btn-primary decoration-0" href={CANVA_URL} target="_blank" rel="noopener">Try in Canva</a>
          <a class="btn-secondary decoration-0" href="/canva/font-studio/buy">Premium plans</a>
        </div>
      </div>
    </section>

    <section class="fs-section">
      <div class="container-sm">
        <h2 class="fs-section__title">What you can do</h2>
        <p class="fs-section__lead">Build professional typography effects with a layering system designed for creative control.</p>
        <div class="fs-features">
          {features.map((f) => (
            <article class="fs-feature">
              <CanvaFeatureIcon icon={f.icon}/>
              <h3>{f.title}</h3>
              <p>{f.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="fs-section fs-section--premium">
      <div class="container-sm fs-premium">
        <div class="fs-premium__copy">
          <p class="fs-premium__eyebrow">FontStudio Premium</p>
          <h2>Unlock the full toolkit</h2>
          <p class="fs-premium__lead">
            Premium adds thousands of fonts, exclusive templates, custom font uploads, and special effects.
            Purchase inside the Canva app — Canva Pro does not include FontStudio Premium.
          </p>
          <ul class="fs-premium__list">
            {premiumFeatures.map((item) => (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M20 6L9 17l-5-5"/>
                </svg>
                {item}
              </li>
            ))}
          </ul>
          <a class="btn-primary decoration-0" href="/canva/font-studio/buy">View plans</a>
        </div>
        <div class="fs-premium__visual" aria-hidden="true">
          <div class="fs-premium__card">
            <span class="fs-premium__card-label">Premium</span>
            <p class="fs-premium__card-stat">15,000<span>+</span></p>
            <p class="fs-premium__card-caption">fonts unlocked</p>
          </div>
        </div>
      </div>
    </section>

    <section class="fs-section">
      <div class="container-sm">
        <h2 class="fs-section__title">Preset gallery</h2>
        <p class="fs-section__lead">A sample of the templates you can create — each one fully customizable.</p>
        <PresetCarousel presets={presets}/>
      </div>
    </section>

    <section class="fs-section fs-section--faq">
      <div class="container-sm">
        <h2 class="fs-section__title">FAQ</h2>
        <div class="fs-faq">
          {faqs.map((item) => (
            <details class="fs-faq__item">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <CanvaAppSupport
      appSlug="font-studio"
      email="fontstudio@randombits.dev"
      supportText="Questions about Premium, licensing, or how the app works — I'm happy to help."
    />
  </CanvaAppShell>
</BaseLayout>
