---
import BaseLayout from "@/layouts/BaseLayout.astro";
import {Image} from 'astro:assets';
import FontStudioLogo from '@/assets/canva/font-studio/logo.png';
---
<BaseLayout title="Manage FontStudio Premium" description="Manage your FontStudio Premium license, upgrade, or request data deletion." noIndex="true">
  <div class="container-sm py-24 fs-manage">
    <header class="fs-manage__hero">
      <div class="flex items-center">
        <Image width="100" src={FontStudioLogo} alt="FontStudio Logo" class="border-solid border-2 rounded-lg mr-10"/>
        <div>
          <p class="fs-manage__eyebrow">FontStudio Premium</p>
          <h1 class="my-0">Manage license</h1>
          <p class="fs-manage__lede">View your license, get help, upgrade, or manage your data.</p>
        </div>
      </div>
    </header>

    <div class="fs-manage__grid">
      <section class="fs-card fs-card--hero">
        <div class="fs-card__head">
          <span class="fs-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 12l2 2 4-4"/>
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </span>
          <h2 class="mt-0">Your license</h2>
        </div>
        <div class="fs-status">
          <span id="license-badge" class="fs-badge fs-badge--idle">Not linked</span>
          <p id="license-status" class="fs-status__text">
            Open this page from the FontStudio app to link it to your Canva account.
          </p>
        </div>
      </section>

      <section class="fs-card">
        <div class="fs-card__head">
          <span class="fs-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
          </span>
          <h2 class="mt-0">Support</h2>
        </div>
        <p class="fs-card__copy">
          Questions or problems with your license? Include your order number or forward your confirmation email.
        </p>
        <a class="btn-secondary btn-small decoration-0 fs-manage__link-btn" href="mailto:fontstudio@randombits.dev">
          fontstudio@randombits.dev
        </a>
      </section>

      <section class="fs-card fs-card--wide">
        <div class="fs-card__head">
          <span class="fs-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 19V5M5 12l7-7 7 7"/>
            </svg>
          </span>
          <div>
            <h2 class="mt-0">Upgrade license</h2>
            <p class="fs-card__sub">Remaining subscription time may be credited at checkout.</p>
          </div>
        </div>
        <div class="fs-plans">
          <article class="fs-plan">
            <div>
              <h3>Yearly subscription</h3>
              <p class="fs-plan__price">$20 <span>/ year</span></p>
            </div>
            <a id="upgrade-yearly" class="btn-primary btn-small decoration-0" href="/canva/font-studio/buy">Upgrade</a>
          </article>
          <article class="fs-plan fs-plan--featured">
            <div class="fs-plan__tag">Best value</div>
            <div>
              <h3>Lifetime license</h3>
              <p class="fs-plan__price">$30 <span>/ one-time</span></p>
            </div>
            <a id="upgrade-lifetime" class="btn-secondary btn-small decoration-0" href="/canva/font-studio/buy">Upgrade</a>
          </article>
        </div>
      </section>

      <section class="fs-card">
        <div class="fs-card__head">
          <span class="fs-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="9" cy="7" r="4"/>
              <path d="M3 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
              <path d="M21 21v-2a4 4 0 0 0-3-3.87"/>
            </svg>
          </span>
          <h2 class="mt-0">Additional licenses</h2>
        </div>
        <p class="fs-card__copy">
          Need Premium for another Canva account or team?
        </p>
        <a id="buy-additional" class="btn-primary btn-small decoration-0" href="/canva/font-studio/buy">
          Purchase another license
        </a>
      </section>

      <section class="fs-card fs-card--danger fs-card--wide">
        <div class="fs-card__head">
          <span class="fs-icon fs-icon--danger" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 6h18"/>
              <path d="M8 6V4h8v2"/>
              <path d="M19 6l-1 14H6L5 6"/>
              <path d="M10 11v6M14 11v6"/>
            </svg>
          </span>
          <div>
            <h2 class="mt-0">Delete your data</h2>
            <p class="fs-card__sub">Right to be forgotten — permanent and irreversible.</p>
          </div>
        </div>
        <p class="fs-card__copy">
          Removes your stored license and app settings. You will need to purchase again to restore Premium.
          See the <a class="underline" href="/canva/font-studio/privacy">Privacy Policy</a> for details.
        </p>

        <label class="fs-check">
          <input type="checkbox" id="delete-confirm"/>
          <span>I understand this permanently deletes my FontStudio data.</span>
        </label>

        <div id="delete-form">
          <button type="button" id="delete-btn" class="fs-btn-danger btn-small" disabled>
            Delete my data
          </button>
        </div>

        <div id="delete-success" class="fs-alert fs-is-hidden">
          Your deletion request has been submitted. Your stored license and settings will be removed.
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .fs-manage__hero {
    margin-bottom: 2rem;
  }

  .fs-manage__eyebrow {
    margin: 0 0 0.25rem;
    font-family: var(--font-1);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-light);
  }

  .fs-manage__lede {
    margin: 0.35rem 0 0;
    font-size: 1.05rem;
    color: var(--color-light);
  }

  .fs-manage__link-btn {
    display: inline-block;
  }

  .fs-manage__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .fs-card {
    padding: 1.35rem 1.4rem;
    border: 2px solid var(--border-color);
    border-radius: var(--border-radius-2);
    background: #fff;
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.8);
  }

  .fs-card--hero {
    background: linear-gradient(160deg, #fff 55%, rgba(255, 191, 35, 0.18));
  }

  .fs-card--wide {
    grid-column: 1 / -1;
  }

  .fs-card--danger {
    border-color: #b91c1c;
    background: linear-gradient(160deg, #fff 60%, rgba(185, 28, 28, 0.06));
    box-shadow: 4px 4px 0 rgba(185, 28, 28, 0.35);
  }

  .fs-card__head {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    margin-bottom: 1rem;
  }

  .fs-card__head h2 {
    font-size: var(--font-size-2);
  }

  .fs-card__sub {
    margin: 0.25rem 0 0;
    color: var(--color-light);
    font-size: 0.95rem;
  }

  .fs-card__copy {
    margin: 0 0 1rem;
    color: var(--color-light);
  }

  .fs-icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    border: 2px solid var(--border-color);
    border-radius: var(--border-radius-2);
    background: var(--back-btn);
    box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.8);
  }

  .fs-icon svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .fs-icon--danger {
    background: #fff;
    border-color: #b91c1c;
    color: #b91c1c;
    box-shadow: 2px 2px 0 rgba(185, 28, 28, 0.35);
  }

  .fs-status {
    display: grid;
    gap: 0.65rem;
  }

  .fs-badge {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    padding: 0.3rem 0.75rem;
    border: 2px solid var(--border-color);
    border-radius: 999px;
    font-family: var(--font-1);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.8);
  }

  .fs-badge--idle {
    background: var(--back-0);
    color: var(--color-light);
  }

  .fs-badge--active {
    background: var(--back-btn);
    color: var(--color-btn);
  }

  .fs-status__text {
    margin: 0;
    color: var(--color-light);
  }

  .fs-plans {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .fs-plan {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    justify-content: space-between;
    min-height: 9rem;
    padding: 1.1rem 1.15rem;
    border: 2px solid var(--border-color);
    border-radius: var(--border-radius-2);
    background: var(--back-0);
    box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.8);
  }

  .fs-plan--featured {
    background: linear-gradient(160deg, var(--back-0) 40%, rgba(255, 191, 35, 0.35));
  }

  .fs-plan__tag {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    padding: 0.2rem 0.55rem;
    border: 2px solid var(--border-color);
    border-radius: 999px;
    background: var(--back-btn);
    font-family: var(--font-1);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.8);
  }

  .fs-plan h3 {
    margin: 0;
    font-family: var(--font-1);
    font-size: 1.15rem;
    font-weight: 500;
  }

  .fs-plan__price {
    margin: 0.35rem 0 0;
    font-family: var(--font-1);
    font-size: 1.5rem;
    font-weight: 500;
  }

  .fs-plan__price span {
    font-family: var(--font-2);
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--color-light);
  }

  .fs-check {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin: 0 0 1rem;
    color: var(--color-light);
    cursor: pointer;
  }

  .fs-check input {
    margin-top: 0.2rem;
    accent-color: #b91c1c;
  }

  .fs-btn-danger {
    padding: 8px 16px;
    font-size: 16px;
    font-weight: bold;
    font-family: var(--font-1);
    border: 2px solid #b91c1c;
    border-radius: var(--border-radius-2);
    background: transparent;
    color: #b91c1c;
    box-shadow: 4px 4px 0 rgba(185, 28, 28, 0.4);
    transition: transform 150ms ease, box-shadow 150ms ease;
  }

  .fs-btn-danger:not(:disabled):hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 rgba(185, 28, 28, 0.4);
  }

  .fs-btn-danger:disabled {
    opacity: 0.45;
    cursor: not-allowed;
    box-shadow: none;
  }

  .fs-alert {
    margin-top: 0.75rem;
    padding: 0.85rem 1rem;
    border: 2px solid var(--border-color);
    border-radius: var(--border-radius-2);
    background: var(--back-btn);
    box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.8);
    font-size: 0.95rem;
  }

  .fs-is-hidden {
    display: none;
  }

  @media (max-width: 720px) {
    .fs-manage__grid,
    .fs-plans {
      grid-template-columns: 1fr;
    }

    .fs-plan {
      min-height: 0;
    }
  }
</style>

<script>
  const params = new URLSearchParams(window.location.search);
  const userId = params.get('userId') || '';
  const teamId = params.get('teamId') || '';
  const hasIds = Boolean(userId && teamId);

  const statusEl = document.getElementById('license-status');
  const badgeEl = document.getElementById('license-badge');
  const confirmEl = document.getElementById('delete-confirm');
  const deleteBtn = document.getElementById('delete-btn');
  const deleteForm = document.getElementById('delete-form');
  const deleteSuccess = document.getElementById('delete-success');

  const linkIds = ['upgrade-yearly', 'upgrade-lifetime', 'buy-additional'];

  linkIds.forEach((id) => {
    const link = document.getElementById(id);
    if (!link || !(link instanceof HTMLAnchorElement)) {
      return;
    }
    const url = new URL(link.href, window.location.origin);
    if (userId) {
      url.searchParams.set('userId', userId);
    }
    if (teamId) {
      url.searchParams.set('teamId', teamId);
    }
    link.href = `${url.pathname}${url.search}`;
  });

  if (hasIds && statusEl && badgeEl) {
    statusEl.textContent = 'Your FontStudio Premium license is linked to your Canva account.';
    badgeEl.textContent = 'Active';
    badgeEl.classList.remove('fs-badge--idle');
    badgeEl.classList.add('fs-badge--active');
  }

  confirmEl?.addEventListener('change', () => {
    if (deleteBtn instanceof HTMLButtonElement) {
      deleteBtn.disabled = !confirmEl.checked;
    }
  });

  deleteBtn?.addEventListener('click', () => {
    if (!confirmEl?.checked) {
      return;
    }
    const confirmed = window.confirm(
      'Are you sure you want to delete your FontStudio data? This cannot be undone.',
    );
    if (!confirmed) {
      return;
    }
    deleteForm?.classList.add('fs-is-hidden');
    deleteSuccess?.classList.remove('fs-is-hidden');
  });
</script>
