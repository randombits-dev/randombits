---
import BaseLayout from "@/layouts/BaseLayout.astro";
import {Image} from 'astro:assets';
import FontStudioLogo from '@/assets/canva/font-studio/logo.png';
---
<BaseLayout title="Manage FontStudio Premium" description="Manage your FontStudio Premium license, upgrade, or request data deletion." noIndex="true">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet"/>
  </Fragment>

  <div class="fs-manage">
    <div class="fs-manage__glow fs-manage__glow--a" aria-hidden="true"></div>
    <div class="fs-manage__glow fs-manage__glow--b" aria-hidden="true"></div>

    <div class="fs-manage__shell">
      <header class="fs-manage__hero">
        <div class="fs-manage__brand">
          <Image width="56" height="56" src={FontStudioLogo} alt="" class="fs-manage__logo"/>
          <div>
            <p class="fs-manage__eyebrow">FontStudio Premium</p>
            <h1 class="fs-manage__title">Account</h1>
          </div>
        </div>
        <p class="fs-manage__lede">Manage your license, get help, or update your plan.</p>
      </header>

      <div class="fs-manage__grid">
        <section class="fs-card fs-card--hero">
          <div class="fs-card__head">
            <span class="fs-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                <path d="M9 12l2 2 4-4"/>
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            </span>
            <h2>Your license</h2>
          </div>
          <div class="fs-status">
            <span id="license-badge" class="fs-badge fs-badge--idle">Not linked</span>
            <p id="license-status" class="fs-status__text">
              Open this page from the FontStudio app to link it to your Canva account.
            </p>
          </div>
        </section>

        <section class="fs-card">
          <div class="fs-card__head">
            <span class="fs-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
              </svg>
            </span>
            <h2>Support</h2>
          </div>
          <p class="fs-card__copy">
            Questions or problems with your license? Reach out and include your order number or forward your confirmation email.
          </p>
          <a class="fs-btn fs-btn--ghost" href="mailto:fontstudio@randombits.dev">
            fontstudio@randombits.dev
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M7 17L17 7M17 7H7M17 7v10"/>
            </svg>
          </a>
        </section>

        <section class="fs-card fs-card--wide">
          <div class="fs-card__head">
            <span class="fs-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                <path d="M12 19V5M5 12l7-7 7 7"/>
              </svg>
            </span>
            <div>
              <h2>Upgrade license</h2>
              <p class="fs-card__sub">Remaining subscription time may be credited at checkout.</p>
            </div>
          </div>
          <div class="fs-plans">
            <article class="fs-plan">
              <div>
                <h3>Yearly</h3>
                <p class="fs-plan__price">$20<span>/year</span></p>
              </div>
              <a id="upgrade-yearly" class="fs-btn fs-btn--solid" href="/canva/font-studio/buy">Upgrade</a>
            </article>
            <article class="fs-plan fs-plan--featured">
              <div class="fs-plan__tag">Best value</div>
              <div>
                <h3>Lifetime</h3>
                <p class="fs-plan__price">$30<span> once</span></p>
              </div>
              <a id="upgrade-lifetime" class="fs-btn fs-btn--solid fs-btn--accent" href="/canva/font-studio/buy">Upgrade</a>
            </article>
          </div>
        </section>

        <section class="fs-card">
          <div class="fs-card__head">
            <span class="fs-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                <circle cx="9" cy="7" r="4"/>
                <path d="M3 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                <path d="M21 21v-2a4 4 0 0 0-3-3.87"/>
              </svg>
            </span>
            <h2>Additional licenses</h2>
          </div>
          <p class="fs-card__copy">
            Need Premium for another Canva account or team?
          </p>
          <a id="buy-additional" class="fs-btn fs-btn--solid" href="/canva/font-studio/buy">
            Purchase another license
          </a>
        </section>

        <section class="fs-card fs-card--danger fs-card--wide">
          <div class="fs-card__head">
            <span class="fs-icon fs-icon--danger" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                <path d="M3 6h18"/>
                <path d="M8 6V4h8v2"/>
                <path d="M19 6l-1 14H6L5 6"/>
                <path d="M10 11v6M14 11v6"/>
              </svg>
            </span>
            <div>
              <h2>Delete your data</h2>
              <p class="fs-card__sub">Right to be forgotten — permanent and irreversible.</p>
            </div>
          </div>
          <p class="fs-card__copy">
            Removes your stored license and app settings. You will need to purchase again to restore Premium.
            See the <a href="/canva/font-studio/privacy">Privacy Policy</a> for details.
          </p>

          <label class="fs-check">
            <input type="checkbox" id="delete-confirm"/>
            <span>I understand this permanently deletes my FontStudio data.</span>
          </label>

          <div id="delete-form">
            <button type="button" id="delete-btn" class="fs-btn fs-btn--danger" disabled>
              Delete my data
            </button>
          </div>

          <div id="delete-success" class="fs-alert fs-is-hidden">
            Your deletion request has been submitted. Your stored license and settings will be removed.
          </div>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .fs-manage {
    --fs-bg: #0c0e14;
    --fs-surface: rgba(255, 255, 255, 0.045);
    --fs-surface-strong: rgba(255, 255, 255, 0.07);
    --fs-border: rgba(255, 255, 255, 0.1);
    --fs-text: #eef0f6;
    --fs-muted: #9aa3b5;
    --fs-accent: #7c6cff;
    --fs-accent-soft: rgba(124, 108, 255, 0.18);
    --fs-danger: #ff6b7a;
    --fs-danger-bg: rgba(255, 107, 122, 0.08);
    --fs-success: #5ee4a7;
    --fs-radius: 20px;
    --fs-radius-sm: 12px;
    --fs-shadow: 0 24px 80px rgba(0, 0, 0, 0.45);

    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin: -2rem 0 0;
    padding: 3.5rem 1.25rem 5rem;
    background:
      radial-gradient(1200px 600px at 10% -10%, rgba(124, 108, 255, 0.22), transparent 55%),
      radial-gradient(900px 500px at 100% 0%, rgba(94, 228, 167, 0.12), transparent 50%),
      var(--fs-bg);
    color: var(--fs-text);
    font-family: "DM Sans", system-ui, sans-serif;
    font-size: 15px;
    line-height: 1.6;
    letter-spacing: 0.01em;
  }

  .fs-manage *,
  .fs-manage *::before,
  .fs-manage *::after {
    box-sizing: border-box;
  }

  .fs-manage__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
    z-index: -1;
  }

  .fs-manage__glow--a {
    width: 420px;
    height: 420px;
    top: -120px;
    left: -80px;
    background: rgba(124, 108, 255, 0.35);
  }

  .fs-manage__glow--b {
    width: 360px;
    height: 360px;
    bottom: -80px;
    right: -60px;
    background: rgba(94, 228, 167, 0.2);
  }

  .fs-manage__shell {
    max-width: 920px;
    margin: 0 auto;
  }

  .fs-manage__hero {
    margin-bottom: 2rem;
  }

  .fs-manage__brand {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .fs-manage__logo {
    border-radius: 14px;
    box-shadow: var(--fs-shadow);
  }

  .fs-manage__eyebrow {
    margin: 0 0 0.15rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fs-muted);
  }

  .fs-manage__title {
    margin: 0;
    font-family: "Instrument Serif", Georgia, serif;
    font-size: clamp(2.4rem, 6vw, 3.4rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .fs-manage__lede {
    margin: 0;
    max-width: 34rem;
    color: var(--fs-muted);
    font-size: 1.05rem;
  }

  .fs-manage__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .fs-card {
    background: linear-gradient(160deg, var(--fs-surface-strong), var(--fs-surface));
    border: 1px solid var(--fs-border);
    border-radius: var(--fs-radius);
    padding: 1.35rem 1.4rem;
    backdrop-filter: blur(12px);
    box-shadow: var(--fs-shadow);
  }

  .fs-card--hero {
    background:
      linear-gradient(145deg, rgba(124, 108, 255, 0.16), transparent 55%),
      linear-gradient(160deg, var(--fs-surface-strong), var(--fs-surface));
  }

  .fs-card--wide {
    grid-column: 1 / -1;
  }

  .fs-card--danger {
    background:
      linear-gradient(145deg, var(--fs-danger-bg), transparent 60%),
      linear-gradient(160deg, var(--fs-surface-strong), var(--fs-surface));
    border-color: rgba(255, 107, 122, 0.25);
  }

  .fs-card__head {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    margin-bottom: 1rem;
  }

  .fs-card__head h2 {
    margin: 0;
    font-family: "Instrument Serif", Georgia, serif;
    font-size: 1.55rem;
    font-weight: 400;
    line-height: 1.15;
  }

  .fs-card__sub {
    margin: 0.25rem 0 0;
    color: var(--fs-muted);
    font-size: 0.92rem;
  }

  .fs-card__copy {
    margin: 0 0 1.1rem;
    color: var(--fs-muted);
  }

  .fs-card__copy a {
    color: var(--fs-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .fs-icon {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--fs-accent-soft);
    color: #c4bcff;
  }

  .fs-icon svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .fs-icon--danger {
    background: rgba(255, 107, 122, 0.15);
    color: var(--fs-danger);
  }

  .fs-status {
    display: grid;
    gap: 0.65rem;
  }

  .fs-badge {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .fs-badge--idle {
    background: rgba(255, 255, 255, 0.06);
    color: var(--fs-muted);
    border: 1px solid var(--fs-border);
  }

  .fs-badge--active {
    background: rgba(94, 228, 167, 0.12);
    color: var(--fs-success);
    border: 1px solid rgba(94, 228, 167, 0.35);
  }

  .fs-status__text {
    margin: 0;
    color: var(--fs-muted);
  }

  .fs-plans {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .fs-plan {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    justify-content: space-between;
    min-height: 9.5rem;
    padding: 1.1rem 1.15rem;
    border-radius: var(--fs-radius-sm);
    border: 1px solid var(--fs-border);
    background: rgba(0, 0, 0, 0.18);
  }

  .fs-plan--featured {
    border-color: rgba(124, 108, 255, 0.45);
    background:
      linear-gradient(160deg, rgba(124, 108, 255, 0.14), rgba(0, 0, 0, 0.12));
  }

  .fs-plan__tag {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: var(--fs-accent-soft);
    color: #d8d2ff;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .fs-plan h3 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
  }

  .fs-plan__price {
    margin: 0.35rem 0 0;
    font-family: "Instrument Serif", Georgia, serif;
    font-size: 2rem;
    line-height: 1;
  }

  .fs-plan__price span {
    font-family: "DM Sans", system-ui, sans-serif;
    font-size: 0.95rem;
    color: var(--fs-muted);
  }

  .fs-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    width: fit-content;
    padding: 0.65rem 1rem;
    border: none;
    border-radius: 999px;
    font-family: inherit;
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    transition: transform 160ms ease, background 160ms ease, opacity 160ms ease;
  }

  .fs-btn svg {
    width: 0.95rem;
    height: 0.95rem;
  }

  .fs-btn:hover:not(:disabled) {
    transform: translateY(-1px);
  }

  .fs-btn--solid {
    background: rgba(255, 255, 255, 0.92);
    color: #12131a;
  }

  .fs-btn--solid:hover {
    background: #fff;
  }

  .fs-btn--accent {
    background: var(--fs-accent);
    color: #fff;
  }

  .fs-btn--accent:hover {
    background: #8f82ff;
  }

  .fs-btn--ghost {
    background: rgba(255, 255, 255, 0.06);
    color: var(--fs-text);
    border: 1px solid var(--fs-border);
  }

  .fs-btn--ghost:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .fs-btn--danger {
    background: transparent;
    color: var(--fs-danger);
    border: 1px solid rgba(255, 107, 122, 0.45);
  }

  .fs-btn--danger:not(:disabled):hover {
    background: rgba(255, 107, 122, 0.12);
  }

  .fs-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    transform: none;
  }

  .fs-check {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin: 0 0 1rem;
    color: var(--fs-muted);
    cursor: pointer;
  }

  .fs-check input {
    margin-top: 0.2rem;
    accent-color: var(--fs-danger);
  }

  .fs-alert {
    margin-top: 0.75rem;
    padding: 0.85rem 1rem;
    border-radius: var(--fs-radius-sm);
    border: 1px solid rgba(94, 228, 167, 0.35);
    background: rgba(94, 228, 167, 0.08);
    color: #b9f5dc;
    font-size: 0.92rem;
  }

  .fs-is-hidden {
    display: none;
  }

  @media (max-width: 720px) {
    .fs-manage {
      padding-top: 2.5rem;
    }

    .fs-manage__grid,
    .fs-plans {
      grid-template-columns: 1fr;
    }

    .fs-plan {
      min-height: 0;
    }
  }
</style>

<script>
  const params = new URLSearchParams(window.location.search);
  const userId = params.get('userId') || '';
  const teamId = params.get('teamId') || '';
  const hasIds = Boolean(userId && teamId);

  const statusEl = document.getElementById('license-status');
  const badgeEl = document.getElementById('license-badge');
  const confirmEl = document.getElementById('delete-confirm');
  const deleteBtn = document.getElementById('delete-btn');
  const deleteForm = document.getElementById('delete-form');
  const deleteSuccess = document.getElementById('delete-success');

  const linkIds = ['upgrade-yearly', 'upgrade-lifetime', 'buy-additional'];

  linkIds.forEach((id) => {
    const link = document.getElementById(id);
    if (!link || !(link instanceof HTMLAnchorElement)) {
      return;
    }
    const url = new URL(link.href, window.location.origin);
    if (userId) {
      url.searchParams.set('userId', userId);
    }
    if (teamId) {
      url.searchParams.set('teamId', teamId);
    }
    link.href = `${url.pathname}${url.search}`;
  });

  if (hasIds && statusEl && badgeEl) {
    statusEl.textContent = 'Your FontStudio Premium license is linked to your Canva account.';
    badgeEl.textContent = 'Active';
    badgeEl.classList.remove('fs-badge--idle');
    badgeEl.classList.add('fs-badge--active');
  }

  confirmEl?.addEventListener('change', () => {
    if (deleteBtn instanceof HTMLButtonElement) {
      deleteBtn.disabled = !confirmEl.checked;
    }
  });

  deleteBtn?.addEventListener('click', () => {
    if (!confirmEl?.checked) {
      return;
    }
    const confirmed = window.confirm(
      'Are you sure you want to delete your FontStudio data? This cannot be undone.',
    );
    if (!confirmed) {
      return;
    }
    deleteForm?.classList.add('fs-is-hidden');
    deleteSuccess?.classList.remove('fs-is-hidden');
  });
</script>
