---
import BaseLayout from "@/layouts/BaseLayout.astro";
import {Image} from 'astro:assets';
import FontStudioLogo from '@/assets/canva/font-studio/logo.png';

const API_BASE = import.meta.env.DEV
  ? 'https://dev.api.randombits.dev'
  : 'https://api.randombits.dev';

// TODO: replace with the real license check endpoint
const LICENSE_CHECK_URL = `${API_BASE}/font-studio/license`;
---
<BaseLayout title="Manage FontStudio Premium" description="Manage your FontStudio Premium license, upgrade, or request data deletion." noIndex="true">
  <div class="container-sm py-24 fs-manage">
    <header class="fs-manage__hero">
      <div class="flex items-center">
        <Image width="100" src={FontStudioLogo} alt="FontStudio Logo" class="border-solid border-2 rounded-lg mr-10"/>
        <div>
          <p class="fs-manage__eyebrow">FontStudio Premium</p>
          <h1 class="my-0">Manage license</h1>
          <p class="fs-manage__lede">View your license, get help, upgrade, or manage your data.</p>
        </div>
      </div>
    </header>

    <div class="fs-manage__grid">
      <section class="fs-card fs-card--hero">
        <div class="fs-card__head">
          <span class="fs-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 12l2 2 4-4"/>
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </span>
          <h2 class="mt-0">Your license</h2>
        </div>
        <div class="fs-status">
          <span id="license-badge" class="fs-badge fs-badge--idle">Checking…</span>
          <p id="license-status" class="fs-status__text">Loading your license details…</p>
        </div>
      </section>

      <section class="fs-card">
        <div class="fs-card__head">
          <span class="fs-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
          </span>
          <h2 class="mt-0">Support</h2>
        </div>
        <p class="fs-card__copy">
          For support, see the main support page page
        </p>
        <a class="btn-secondary btn-small decoration-0 fs-manage__link-btn" href="/canva/font-studio">
          Support
        </a>
      </section>

      <section class="fs-card fs-card--wide">
        <div class="fs-card__head">
          <span class="fs-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 19V5M5 12l7-7 7 7"/>
            </svg>
          </span>
          <div>
            <h2 class="mt-0">Upgrade license</h2>
            <p class="fs-card__sub">Remaining subscription time may be credited at checkout.</p>
          </div>
        </div>
        <div class="fs-plans">
          <article class="fs-plan">
            <div>
              <h3>Yearly subscription</h3>
              <p class="fs-plan__price">$20 <span>/ year</span></p>
            </div>
            <a id="upgrade-yearly" class="btn-primary btn-small decoration-0" href="/canva/font-studio/buy">Upgrade</a>
          </article>
          <article class="fs-plan fs-plan--featured">
            <div class="fs-plan__tag">Best value</div>
            <div>
              <h3>Lifetime license</h3>
              <p class="fs-plan__price">$30 <span>/ one-time</span></p>
            </div>
            <a id="upgrade-lifetime" class="btn-secondary btn-small decoration-0" href="/canva/font-studio/buy">Upgrade</a>
          </article>
        </div>
      </section>

      <section class="fs-card">
        <div class="fs-card__head">
          <span class="fs-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="9" cy="7" r="4"/>
              <path d="M3 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
              <path d="M21 21v-2a4 4 0 0 0-3-3.87"/>
            </svg>
          </span>
          <h2 class="mt-0">Additional licenses</h2>
        </div>
        <p class="fs-card__copy">
          Need Premium for another Canva account or team?
        </p>
        <a id="buy-additional" class="btn-primary btn-small decoration-0" href="/canva/font-studio/buy">
          Purchase another license
        </a>
      </section>

      <!--<section class="fs-card fs-card&#45;&#45;danger fs-card&#45;&#45;wide">-->
      <!--  <div class="fs-card__head">-->
      <!--    <span class="fs-icon fs-icon&#45;&#45;danger" aria-hidden="true">-->
      <!--      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">-->
      <!--        <path d="M3 6h18"/>-->
      <!--        <path d="M8 6V4h8v2"/>-->
      <!--        <path d="M19 6l-1 14H6L5 6"/>-->
      <!--        <path d="M10 11v6M14 11v6"/>-->
      <!--      </svg>-->
      <!--    </span>-->
      <!--    <div>-->
      <!--      <h2 class="mt-0">Delete your data</h2>-->
      <!--    </div>-->
      <!--  </div>-->
      <!--  <p class="fs-card__copy">-->
      <!--    The only personal information collected is while purchasing Premium through the payment provider Lemon Squeezy. See the <a href="https://www.lemonsqueezy.com/privacy-policy" target="_blank" rel="noopener noreferrer">Lemon Squeezy Privacy Policy</a> for more information about removing your data.-->
      <!--  </p>-->

      <!--  <div id="delete-success" class="fs-alert fs-is-hidden">-->
      <!--    Your deletion request has been submitted. Your stored license and settings will be removed.-->
      <!--  </div>-->
      <!--</section>-->
    </div>
  </div>
</BaseLayout>

<style>
  .fs-manage__hero {
    margin-bottom: 2rem;
  }

  .fs-manage__eyebrow {
    margin: 0 0 0.25rem;
    font-family: var(--font-1);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-light);
  }

  .fs-manage__lede {
    margin: 0.35rem 0 0;
    font-size: 1.05rem;
    color: var(--color-light);
  }

  .fs-manage__link-btn {
    display: inline-block;
  }

  .fs-manage__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .fs-card {
    padding: 1.35rem 1.4rem;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-2);
    background: #fff;
  }

  .fs-card--hero {
    background: linear-gradient(160deg, #fff 55%, rgba(255, 191, 35, 0.18));
  }

  .fs-card--wide {
    grid-column: 1 / -1;
  }

  .fs-card--danger {
    border-color: #b91c1c;
    background: linear-gradient(160deg, #fff 60%, rgba(185, 28, 28, 0.06));
  }

  .fs-card__head {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    margin-bottom: 1rem;
  }

  .fs-card__head h2 {
    font-size: var(--font-size-2);
  }

  .fs-card__sub {
    margin: 0.25rem 0 0;
    color: var(--color-light);
    font-size: 0.95rem;
  }

  .fs-card__copy {
    margin: 0 0 1rem;
    color: var(--color-light);
  }

  .fs-icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    border: 2px solid var(--border-color);
    border-radius: var(--border-radius-2);
    background: var(--back-btn);
  }

  .fs-icon svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .fs-icon--danger {
    background: #fff;
    border-color: #b91c1c;
    color: #b91c1c;
  }

  .fs-status {
    display: grid;
    gap: 0.65rem;
  }

  .fs-badge {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    padding: 0.3rem 0.75rem;
    border: 2px solid var(--border-color);
    border-radius: 999px;
    font-family: var(--font-1);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .fs-badge--idle {
    background: var(--back-0);
    color: var(--color-light);
  }

  .fs-badge--active {
    background: var(--back-btn);
    color: var(--color-btn);
  }

  .fs-badge--inactive {
    background: var(--back-0);
    color: var(--color-light);
  }

  .fs-badge--error {
    background: rgba(185, 28, 28, 0.08);
    color: #b91c1c;
    border-color: #b91c1c;
  }

  .fs-status__text {
    margin: 0;
    color: var(--color-light);
  }

  .fs-plans {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .fs-plan {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    justify-content: space-between;
    min-height: 9rem;
    padding: 1.1rem 1.15rem;
    border: 2px solid var(--border-color);
    border-radius: var(--border-radius-2);
    background: var(--back-0);
  }

  .fs-plan--featured {
    background: linear-gradient(160deg, var(--back-0) 40%, rgba(255, 191, 35, 0.35));
  }

  .fs-plan__tag {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    padding: 0.2rem 0.55rem;
    border: 2px solid var(--border-color);
    border-radius: 999px;
    background: var(--back-btn);
    font-family: var(--font-1);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .fs-plan h3 {
    margin: 0;
    font-family: var(--font-1);
    font-size: 1.15rem;
    font-weight: 500;
  }

  .fs-plan__price {
    margin: 0.35rem 0 0;
    font-family: var(--font-1);
    font-size: 1.5rem;
    font-weight: 500;
  }

  .fs-plan__price span {
    font-family: var(--font-2);
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--color-light);
  }

  .fs-check {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin: 0 0 1rem;
    color: var(--color-light);
    cursor: pointer;
  }

  .fs-check input {
    margin-top: 0.2rem;
    accent-color: #b91c1c;
  }

  .fs-btn-danger {
    padding: 8px 16px;
    font-size: 16px;
    font-weight: bold;
    font-family: var(--font-1);
    border: 2px solid #b91c1c;
    border-radius: var(--border-radius-2);
    background: transparent;
    color: #b91c1c;
    transition: background 150ms ease;
  }

  .fs-btn-danger:not(:disabled):hover {
    background: rgba(185, 28, 28, 0.08);
  }

  .fs-btn-danger:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .fs-alert {
    margin-top: 0.75rem;
    padding: 0.85rem 1rem;
    border: 2px solid var(--border-color);
    border-radius: var(--border-radius-2);
    background: var(--back-btn);
    font-size: 0.95rem;
  }

  .fs-manage :global(.btn-primary),
  .fs-manage :global(.btn-secondary) {
    box-shadow: none;
  }

  .fs-manage :global(.btn-primary:hover),
  .fs-manage :global(.btn-secondary:hover) {
    transform: none;
    box-shadow: none;
  }

  .fs-is-hidden {
    display: none;
  }

  @media (max-width: 720px) {
    .fs-manage__grid,
    .fs-plans {
      grid-template-columns: 1fr;
    }

    .fs-plan {
      min-height: 0;
    }
  }
</style>

<script define:vars={{LICENSE_CHECK_URL}}>
  const hashParams = new URLSearchParams(window.location.hash.slice(1));
  const userId = hashParams.get('userId') || '';
  const teamId = hashParams.get('teamId') || '';

  if (!userId || !teamId) {
    window.location.replace('/canva/font-studio');
  } else {
    const statusEl = document.getElementById('license-status');
    const badgeEl = document.getElementById('license-badge');
    const confirmEl = document.getElementById('delete-confirm');
    const deleteBtn = document.getElementById('delete-btn');
    const deleteForm = document.getElementById('delete-form');
    const deleteSuccess = document.getElementById('delete-success');

    const linkIds = ['upgrade-yearly', 'upgrade-lifetime', 'buy-additional'];
    const linkHash = new URLSearchParams({userId, teamId}).toString();

    linkIds.forEach((id) => {
      const link = document.getElementById(id);
      if (!link || !(link instanceof HTMLAnchorElement)) {
        return;
      }
      const url = new URL(link.href, window.location.origin);
      link.href = `${url.pathname}#${linkHash}`;
    });

    function setBadge(state, label) {
      if (!badgeEl) {
        return;
      }
      badgeEl.textContent = label;
      badgeEl.classList.remove('fs-badge--idle', 'fs-badge--active', 'fs-badge--inactive', 'fs-badge--error');
      badgeEl.classList.add(`fs-badge--${state}`);
    }

    function formatPlanName(plan) {
      const names = {
        monthly: 'Monthly subscription',
        yearly: 'Yearly subscription',
        lifetime: 'Lifetime license',
      };
      return names[plan] || plan;
    }

    function renderLicense(data) {
      const active = Boolean(data?.active ?? data?.hasLicense ?? data?.license);
      const plan = data?.plan || data?.product?.split('-')?.[0] || '';
      const licenseType = data?.type || data?.product?.split('-')?.[1] || '';

      if (active) {
        setBadge('active', 'Active');
        const parts = ['Your FontStudio Premium license is active.'];
        if (plan) {
          parts.push(`Plan: ${formatPlanName(plan)}.`);
        }
        if (licenseType) {
          parts.push(`Type: ${licenseType}.`);
        }
        if (statusEl) {
          statusEl.textContent = parts.join(' ');
        }
        return;
      }

      setBadge('inactive', 'No license');
      if (statusEl) {
        statusEl.textContent = 'No active Premium license was found for this Canva account.';
      }
    }

    function renderLicenseError() {
      setBadge('error', 'Unavailable');
      if (statusEl) {
        statusEl.textContent = 'Could not load your license details. Try again later or contact support.';
      }
    }

    async function checkLicense() {
      try {
        const url = new URL(LICENSE_CHECK_URL);
        url.searchParams.set('userId', userId);
        url.searchParams.set('teamId', teamId);
        const response = await fetch(url);
        if (!response.ok) {
          throw new Error(`License check failed: ${response.status}`);
        }
        const data = await response.json();
        renderLicense(data);
      } catch {
        renderLicenseError();
      }
    }

    checkLicense();

    confirmEl?.addEventListener('change', () => {
      if (deleteBtn instanceof HTMLButtonElement) {
        deleteBtn.disabled = !confirmEl.checked;
      }
    });

    deleteBtn?.addEventListener('click', () => {
      if (!confirmEl?.checked) {
        return;
      }
      const confirmed = window.confirm(
        'Are you sure you want to delete your FontStudio data? This cannot be undone.',
      );
      if (!confirmed) {
        return;
      }
      deleteForm?.classList.add('fs-is-hidden');
      deleteSuccess?.classList.remove('fs-is-hidden');
    });
  }
</script>
