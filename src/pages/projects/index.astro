---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectList from "../../components/ProjectList.astro";
import {PROJECTS} from "../../data/projects.ts";
---
<BaseLayout title="Projects by Random Bits" description="A list of all open source projects created by Random Bits">
  <div class="page-hero">
    <h1 class="page-hero__title">Open source projects</h1>
    <p class="page-hero__subtitle">Side projects, tools, and experiments from Random Bits.</p>
  </div>
  <div class="container pb-24">
    <ProjectList items={PROJECTS}/>
  </div>
</BaseLayout>
